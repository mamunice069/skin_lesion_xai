{
  "run_name": "smoke_isic2020_effnetv2_s",
  "smoke": true,
  "data_config": "configs/data/isic2020.yaml",
  "model_config": "configs/model/effnetv2_s.yaml",
  "data": {
    "name": "isic2020",
    "task": "binary",
    "data_root": "..",
    "image_dir": "datasets/isic2020/images",
    "metadata_csv": "datasets/isic2020/train-metadata.csv",
    "id_col": "isic_id",
    "label_col": "target",
    "group_col": "patient_id",
    "classes": [
      "benign",
      "melanoma"
    ],
    "split_csv": "data/splits/isic2020.csv",
    "mask_dir": null,
    "mask_suffix": "_segmentation.png",
    "image_ext": ".jpg",
    "split_ratios": {
      "train": 0.7,
      "val": 0.15,
      "test": 0.15
    },
    "split_folds": 20,
    "seed": 42,
    "hair_removed_dir": "data/processed/isic2020_dullrazor",
    "use_hair_removal": false,
    "dullrazor": {
      "kernel_size": 11,
      "threshold": 12,
      "min_length_frac": 0.08,
      "min_elongation": 8.0,
      "dilate": 1,
      "inpaint_radius": 2
    },
    "image_size": 224
  },
  "model": {
    "name": "effnetv2_s",
    "arch": "single_branch",
    "timm_name": "tf_efficientnetv2_s.in21k_ft_in1k",
    "pretrained": true,
    "drop_rate": 0.2,
    "drop_path_rate": 0.1
  },
  "train": {
    "epochs": 1,
    "batch_size": 8,
    "accum_steps": 4,
    "num_workers": 1,
    "val_num_workers": 0,
    "backbone_lr": 0.0001,
    "head_lr": 0.001,
    "weight_decay": 0.05,
    "warmup_epochs": 3,
    "min_lr_ratio": 0.01,
    "grad_clip": 1.0,
    "label_smoothing": 0.1,
    "loss": "ce",
    "focal_gamma": 2.0,
    "class_weight_power": 0.5,
    "sampler": "none",
    "ema_decay": 0.999,
    "early_stop_patience": 7,
    "monitor": "auto",
    "amp": true,
    "grad_checkpointing": true,
    "seed": 42
  },
  "train_class_counts": [
    196,
    4
  ],
  "loss_class_weights": [
    0.25,
    1.75
  ],
  "max_train": 200,
  "max_val": 100
}